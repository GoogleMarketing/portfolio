    <!-- Chat Widget -->
    <div id="chatWidget" class="chat-widget"><div class="chat-header"><span><i class="fas fa-comments" style="color:var(--primary-color);"></i> Live Chat</span><button onclick="toggleChat()" style="background:none;border:none;color:white;cursor:pointer;"><i class="fas fa-times"></i></button></div><div id="chatMessages" class="chat-messages"></div><div class="chat-input-area"><input id="chatInput" placeholder="Type your message..." onkeypress="if(event.key==='Enter') sendChatMessage()"><button onclick="sendChatMessage()" style="background:var(--primary-color);border:none;color:white;padding:10px 16px;border-radius:20px;cursor:pointer;"><i class="fas fa-paper-plane"></i></button></div></div>
    <button id="chatToggleBtn" onclick="toggleChat()" style="position:fixed;bottom:20px;left:20px;z-index:3999;background:#25D366;color:white;border:none;padding:14px 18px;border-radius:50%;cursor:pointer;box-shadow:0 8px 20px rgba(0,0,0,0.3);display:none;"><i class="fas fa-comments" style="font-size:1.3rem;"></i></button>
    <script>
        // Firebase Config - Same project as before
        const firebaseConfig = {
            apiKey: "",
            authDomain: "email-marketing-d7597.firebaseapp.com",
            databaseURL: "https://email-marketing-d7587-default-rtdb.asia-southeast1.firebasedatabase.app",
            projectId: "",
            storageBucket: "email-marketing-d7597.firebasestorage.app",
            messagingSenderId: "317421169576",
            appId: "1:317421169576:web:c11a90d1033395d6720b9d"
        };
        const ADMIN_EMAILS = ["afshakil279@gmail.com"];
        if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);
        const auth = firebase.auth();
        const db = firebase.firestore();
        let currentUser = null;
        let isAdmin = false;

        // Auth Modal
        function openAuthModal() { document.getElementById('authModal').classList.add('active'); }
        function closeAuthModal() { document.getElementById('authModal').classList.remove('active'); }
        function toggleMenu() { document.getElementById('mobileMenu').classList.toggle('active'); }
        function openModal(src) { document.getElementById('imageModal').style.display = 'flex'; document.getElementById('modalImg').src = src; }
        function closeModal() { document.getElementById('imageModal').style.display = 'none'; }

        // FAQ
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.faq-item').forEach(item => {
                item.querySelector('.faq-question').addEventListener('click', () => {
                    const isActive = item.classList.contains('active');
                    document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('active'));
                    if (!isActive) item.classList.add('active');
                });
            });
        });

        // Auth Logic
        async function handleEmailAuth() {
            const email = document.getElementById('authEmail').value.trim();
            const pass = document.getElementById('authPass').value.trim();
            if (!email || pass.length < 6) return alert('Email and password (min 6) required');
            try {
                await auth.signInWithEmailAndPassword(email, pass);
            } catch (e) {
                if (e.code === 'auth/user-not-found' || e.code === 'auth/invalid-credential') {
                    try { await auth.createUserWithEmailAndPassword(email, pass); } catch (err) { alert(err.message); return; }
                } else { alert(e.message); return; }
            }
            closeAuthModal();
        }
        async function handleGoogleAuth() {
            try {
                const provider = new firebase.auth.GoogleAuthProvider();
                await auth.signInWithPopup(provider);
                closeAuthModal();
            } catch (e) { alert(e.message); }
        }
        function handleLogout() {
            auth.signOut();
        }

        auth.onAuthStateChanged(async (user) => {
            currentUser = user;
            const authBtn = document.getElementById('authBtn');
            const welcome = document.getElementById('userWelcome');
            const privateSection = document.getElementById('privatePricing');
            const overlay = document.getElementById('pricingLoginPrompt');
            const chatBtn = document.getElementById('chatToggleBtn');
            if (user) {
                isAdmin = ADMIN_EMAILS.includes(user.email);
                authBtn.innerHTML = `<i class="fas fa-sign-out-alt"></i> ${user.email.split('@')[0]} | Logout`;
                authBtn.onclick = handleLogout;
                welcome.style.display = 'inline';
                welcome.innerText = `Hi, ${user.email}`;
                privateSection.classList.add('unlocked');
                overlay.style.display = 'none';
                privateSection.style.display = 'block';
                chatBtn.style.display = 'block';
                // Create user doc
                await db.collection('gm_users').doc(user.uid).set({ email: user.email, role: isAdmin ? 'admin' : 'user', lastLogin: firebase.firestore.FieldValue.serverTimestamp() }, { merge: true });
                if (isAdmin) {
                    document.getElementById('adminToggleBtn').classList.add('show');
                    loadAdminData();
                    listenInquiries();
                }
                listenChat();
                listenSettings();
            } else {
                isAdmin = false;
                authBtn.innerHTML = `<i class="fas fa-user"></i> Login`;
                authBtn.onclick = openAuthModal;
                welcome.style.display = 'none';
                privateSection.classList.remove('unlocked');
                overlay.style.display = 'flex';
                privateSection.style.display = 'block';
                chatBtn.style.display = 'none';
                document.getElementById('adminToggleBtn').classList.remove('show');
                document.getElementById('adminPanel').classList.remove('active');
            }
        });

        // Settings Listeners (Public + Private)
        function listenSettings() {
            db.collection('gm_settings').doc('stats').onSnapshot(doc => {
                if (doc.exists) {
                    const d = doc.data();
                    if (d.projects) document.getElementById('statProjects').innerText = d.projects;
                    if (d.clients) document.getElementById('statClients').innerText = d.clients;
                    if (d.years) document.getElementById('statYears').innerText = d.years;
                    document.getElementById('adminStatProjects').value = d.projects || '';
                    document.getElementById('adminStatClients').value = d.clients || '';
                    document.getElementById('adminStatYears').value = d.years || '';
                }
            });
            db.collection('gm_settings').doc('pricing').onSnapshot(doc => {
                if (doc.exists && currentUser) {
                    const d = doc.data();
                    if (d.play) document.getElementById('pricePlay').innerHTML = d.play;
                    if (d.map) document.getElementById('priceMap').innerHTML = d.map;
                    if (d.seo) document.getElementById('priceSeo').innerHTML = d.seo;
                    if (d.lead) document.getElementById('priceLead').innerHTML = d.lead;
                    document.getElementById('adminPricePlay').value = d.play || '';
                    document.getElementById('adminPriceMap').value = d.map || '';
                    document.getElementById('adminPriceSeo').value = d.seo || '';
                    document.getElementById('adminPriceLead').value = d.lead || '';
                }
            });
        }
        // Initial load for public stats
        db.collection('gm_settings').doc('stats').get().then(doc => {
            if (doc.exists) {
                const d = doc.data();
                if (d.projects) document.getElementById('statProjects').innerText = d.projects;
                if (d.clients) document.getElementById('statClients').innerText = d.clients;
                if (d.years) document.getElementById('statYears').innerText = d.years;
            }
        });

        // Admin Actions
        function toggleAdminPanel() { document.getElementById('adminPanel').classList.toggle('active'); }
        async function saveStats() {
            if (!isAdmin) return alert('Admin only');
            const p = document.getElementById('adminStatProjects').value.trim();
            const c = document.getElementById('adminStatClients').value.trim();
            const y = document.getElementById('adminStatYears').value.trim();
            await db.collection('gm_settings').doc('stats').set({ projects: p, clients: c, years: y, updatedBy: currentUser.email, updatedAt: firebase.firestore.FieldValue.serverTimestamp() }, { merge: true });
            alert('Stats Saved!');
        }
        async function savePricing() {
            if (!isAdmin) return alert('Admin only');
            const play = document.getElementById('adminPricePlay').value.trim();
            const map = document.getElementById('adminPriceMap').value.trim();
            const seo = document.getElementById('adminPriceSeo').value.trim();
            const lead = document.getElementById('adminPriceLead').value.trim();
            await db.collection('gm_settings').doc('pricing').set({ play, map, seo, lead, updatedBy: currentUser.email, updatedAt: firebase.firestore.FieldValue.serverTimestamp() }, { merge: true });
            alert('Pricing Saved! Only logged-in users can see it.');
        }
        async function addReviewImage() {
            if (!isAdmin) return alert('Admin only');
            const url = document.getElementById('adminReviewUrl').value.trim();
            if (!url) return alert('URL required');
            await db.collection('gm_reviews').add({ url, createdAt: firebase.firestore.FieldValue.serverTimestamp(), createdBy: currentUser.email });
            document.getElementById('adminReviewUrl').value = '';
            alert('Review Added!');
        }
        // Listen Reviews
        db.collection('gm_reviews').orderBy('createdAt', 'desc').limit(20).onSnapshot(snap => {
            const grid = document.getElementById('reviewsGrid');
            // Keep existing 6 + add new
            snap.forEach(doc => {
                const data = doc.data();
                if (!document.querySelector(`img[src="${data.url}"]`)) {
                    const div = document.createElement('div');
                    div.className = 'gallery-item';
                    div.onclick = () => openModal(data.url);
                    div.innerHTML = `<img src="${data.url}" alt="Review" loading="lazy">`;
                    grid.prepend(div);
                }
            });
        });

        // Contact Form + Firestore Save
        function showOptions() {
            const appName = document.getElementById('appName').value.trim();
            const contact = document.getElementById('userContact').value.trim();
            if (!appName || !contact) return alert('Please fill in App Name/ID and your Contact Info');
            document.getElementById('mainSubmitBtn').style.display = 'none';
            document.getElementById('sendOptionsBlock').style.display = 'flex';
            // Save inquiry to Firestore (even without login, save as guest)
            db.collection('gm_inquiries').add({
                appName, contact, message: document.getElementById('userMessage').value.trim(),
                uid: currentUser ? currentUser.uid : 'guest',
                email: currentUser ? currentUser.email : 'guest',
                createdAt: firebase.firestore.FieldValue.serverTimestamp()
            });
        }
        function sendMessage(platform) {
            const appName = document.getElementById('appName').value.trim();
            const contact = document.getElementById('userContact').value.trim();
            const message = document.getElementById('userMessage').value.trim() || 'No additional message.';
            const textRaw = `🚀 *New Service Request* 🚀\n\n📱 *App/Target:* ${appName}\n📞 *Client Info:* ${contact}\n💬 *Message:* ${message}\n👤 *User:* ${currentUser ? currentUser.email : 'Guest'}`;
            const encodedText = encodeURIComponent(textRaw);
            if (platform === 'whatsapp') window.open(`https://wa.me/8801647323233?text=${encodedText}`, '_blank');
            else if (platform === 'telegram') window.open(`https://t.me/DirectorShakil?text=${encodedText}`, '_blank');
            else if (platform === 'email') window.open(`mailto:24.7.g00glemarketing@gmail.com?subject=${encodeURIComponent('New Service Request - Google Marketing')}&body=${encodedText}`, '_blank');
        }
        function listenInquiries() {
            db.collection('gm_inquiries').orderBy('createdAt', 'desc').limit(15).onSnapshot(snap => {
                const box = document.getElementById('adminInquiries');
                box.innerHTML = '';
                snap.forEach(doc => {
                    const d = doc.data();
                    const div = document.createElement('div');
                    div.style.cssText = 'background:rgba(255,255,255,0.05);padding:10px;border-radius:10px;font-size:0.8rem;border:1px solid var(--border-color);';
                    div.innerHTML = `<b>${d.appName || 'No App'}</b><br><span style="color:var(--text-muted);">${d.contact} | ${d.email}</span><br><span style="font-size:0.75rem;">${d.message?.substring(0,60) || ''}</span>`;
                    box.appendChild(div);
                });
            });
        }

        // Real-time Chat (Firestore)
        function toggleChat() { document.getElementById('chatWidget').classList.toggle('active'); }
        function listenChat() {
            if (!currentUser) return;
            db.collection('gm_chats').doc(currentUser.uid).collection('messages').orderBy('createdAt', 'asc').limit(50).onSnapshot(snap => {
                const box = document.getElementById('chatMessages');
                box.innerHTML = '';
                snap.forEach(doc => {
                    const m = doc.data();
                    const div = document.createElement('div');
                    div.className = `chat-msg ${m.sender === currentUser.uid ? 'user' : 'admin'}`;
                    div.innerText = m.text;
                    box.appendChild(div);
                });
                box.scrollTop = box.scrollHeight;
            });
        }
        async function sendChatMessage() {
            if (!currentUser) return openAuthModal();
            const input = document.getElementById('chatInput');
            const text = input.value.trim();
            if (!text) return;
            await db.collection('gm_chats').doc(currentUser.uid).collection('messages').add({
                text, sender: currentUser.uid, senderEmail: currentUser.email,
                createdAt: firebase.firestore.FieldValue.serverTimestamp()
            });
            // Also create chat doc for admin list
            await db.collection('gm_chats').doc(currentUser.uid).set({ lastMessage: text, lastEmail: currentUser.email, updatedAt: firebase.firestore.FieldValue.serverTimestamp() }, { merge: true });
            input.value = '';
        }
        function loadAdminData() {
            // Load stats and pricing already handled by listeners
        }
    </script>
<script>(function(){var loc=location.href.replace(/#.*$/,"");var ATTR_NAMES=["data-product-id","data-productid","data-product_id","product-id","productid","product_id","data-source-entity-id","source-entity-id","source_entity_id","data-product","data-metadata","data-meta"];var DATASET_KEYS=["productId","productid","product_id","sourceEntityId","sourceentityid","source_entity_id","product","metadata","meta"];function readProductId(value){if(typeof value!=="string"||value.length===0)return null;if(/^[0-9]{6,}$/.test(value))return value;var match=value.match(/(?:product(?:_|-)?id|source(?:_|-)?entity(?:_|-)?id)["'=:\s]+([0-9]{6,})/i);return match?match[1]:null}function extractProductId(start){for(var node=start;node&&node!==document.body;node=node.parentElement){for(var i=0;i<ATTR_NAMES.length;i++){var attrValue=node.getAttribute&&node.getAttribute(ATTR_NAMES[i]);var attrProductId=readProductId(attrValue);if(attrProductId)return attrProductId}var dataset=node.dataset||null;if(dataset){for(var j=0;j<DATASET_KEYS.length;j++){var dataValue=dataset[DATASET_KEYS[j]];var dataProductId=readProductId(dataValue);if(dataProductId)return dataProductId}}}return null}function isInlineMediaSlotElement(node){return !!(node&&node.getAttribute&&node.getAttribute("data-clippy-inline-media-slot")!==null)}function findInlineMediaSlot(start){for(var node=start;node&&node!==document.body;node=node.parentElement){if(isInlineMediaSlotElement(node))return node}return null}function readInlineMediaUrl(node){if(!node)return null;return node.getAttribute&&((node.getAttribute("data-clippy-inline-media-url")||node.getAttribute("data-url")||node.getAttribute("data_url")))||node.href||null}function stripHash(url){return String(url).replace(/#.*$/,"")}function urlsMatch(a,b){if(!a||!b)return false;try{return stripHash(new URL(a,loc).href)===stripHash(new URL(b,loc).href)}catch(_){return stripHash(a)===stripHash(b)}}function isFirstPartyReelUrl(value){try{var url=new URL(value,loc);if(url.protocol!=="https:")return false;var host=url.hostname.toLowerCase();var supported=host==="instagram.com"||host.endsWith(".instagram.com")||host==="facebook.com"||host.endsWith(".facebook.com");return supported&&/\/reels?\//i.test(url.pathname)}catch(_){return false}}function isInlineMediaUrlClick(node,href){var slot=findInlineMediaSlot(node);if(!slot)return false;var slotUrl=readInlineMediaUrl(slot);if(slotUrl)return urlsMatch(href,slotUrl);return isFirstPartyReelUrl(href)}function findDataHref(start){for(var node=start;node&&node!==document.body;node=node.parentElement){if(node.getAttribute){var href=node.getAttribute("data-href")||node.getAttribute("data-url");if(href)return{href:href,node:node}}}return null}var nativeOpen=window.open;window.open=function(url){if(parent!==window&&typeof url==="string"&&/^https?:\/\//.test(url)){parent.postMessage({type:"ecto:usercontent-link-click",href:url},"*");return null}return nativeOpen?nativeOpen.apply(window,arguments):null};document.addEventListener("click",function(e){var target=e.target instanceof Element?e.target:null;if(!target)return;if(parent===window)return;var a=target.closest?target.closest("a[href]"):null;if(a&&a.href&&/^https?:\/\//.test(a.href)&&a.href.replace(/#.*$/,"")!==loc){if(isInlineMediaUrlClick(a,a.href))return;var productId=extractProductId(target)||extractProductId(a);if(productId){e.preventDefault();parent.postMessage({type:"ecto-artifact-link-click",productId:productId},"*");return}e.preventDefault();parent.postMessage({type:"ecto:usercontent-link-click",href:a.href},"*");return}var dataHref=findDataHref(target);if(dataHref&&/^https?:\/\//.test(dataHref.href)&&dataHref.href.replace(/#.*$/,"")!==loc){if(isInlineMediaUrlClick(dataHref.node,dataHref.href))return;e.preventDefault();parent.postMessage({type:"ecto:usercontent-link-click",href:dataHref.href},"*")}},true)})();</script><script>(function(){var FOCUS_TYPE="ecto:artifact-focus-request";var CLOSE_TYPE="ecto:artifact-close-request";function focusArtifactDocument(){var body=document.body;if(!body)return;try{window.focus();}catch(e){}if(!body.hasAttribute("tabindex"))body.setAttribute("tabindex","-1");try{body.focus({preventScroll:true});}catch(e){try{body.focus();}catch(e2){}}}window.addEventListener("message",function(event){if(event.source!==window.parent)return;var data=event.data;if(!data||typeof data!=="object"||data.type!==FOCUS_TYPE)return;if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",focusArtifactDocument,{once:true});return;}focusArtifactDocument();});window.addEventListener("keydown",function(event){if(event.key!=="Escape")return;window.setTimeout(function(){if(event.defaultPrevented)return;window.parent.postMessage({type:CLOSE_TYPE},"*");},0);});})();</script></body>
</html>
