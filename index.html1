        <div style="margin-bottom:20px;"><h4 style="font-size:0.9rem;color:var(--text-muted);margin-bottom:10px;">STATS EDITOR</h4><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;"><input id="adminStatProjects" class="auth-input" placeholder="Projects (e.g. 500+)"><input id="adminStatClients" class="auth-input" placeholder="Clients (e.g. 300+)"><input id="adminStatYears" class="auth-input" placeholder="Years (e.g. 3+)"></div><button class="auth-btn" onclick="saveStats()">Save Stats</button></div>
