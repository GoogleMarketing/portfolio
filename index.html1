        <div><h4 style="font-size:0.9rem;color:var(--text-muted);margin-bottom:10px;">RECENT INQUIRIES</h4><div id="adminInquiries" style="max-height:200px;overflow-y:auto;display:flex;flex-direction:column;gap:8px;"></div></div>
