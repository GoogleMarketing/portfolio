import axios from "axios";

const BOT_TOKEN = functions.config().telegram.token;
const CHAT_ID = "YOUR_ADMIN_CHAT_ID"; // @userinfobot

export const onNewLead = functions.firestore
  .document("leads/{leadId}")
  .onCreate(async (snap) => {
    const lead = snap.data();
    const msg = \`\uD83D\uDE80 New Lead!
Service: \${lead.service}
Budget: $\${lead.budget}
Email: \${lead.email}\`;

    await axios.post(\`https://api.telegram.org/bot\${BOT_TOKEN}/sendMessage\`, {
      chat_id: CHAT_ID,
      text: msg,
      parse_mode: "Markdown"
    });
  });

// Webhook for reply: /telegramWebhook
export const telegramWebhook = functions.https.onRequest(async (req,res)=>{
  const { message } = req.body;
  // save to RTDB for website sync
  // ...
  res.send("ok");
});`}),d("div",{className:"space-y-3",children:[d("div",{className:"rounded-[14px] border border-white/[0.08] bg-white/[0.03] p-4",children:[s("div",{className:"text-[12px] font-semibold mb-2",children:"Setup Checklist"}),d("ul",{className:"space-y-2 text-[12px] text-white/60",children:[d("li",{className:"flex gap-2",children:[s(Ze,{className:"w-4 h-4 text-emerald-400 shrink-0"})," BotFather → /newbot → token copy"]}),d("li",{className:"flex gap-2",children:[s(Ze,{className:"w-4 h-4 text-emerald-400 shrink-0"}),' firebase functions:config:set telegram.token="xxx"']}),d("li",{className:"flex gap-2",children:[s(Ze,{className:"w-4 h-4 text-emerald-400 shrink-0"})," firebase deploy --only functions"]}),d("li",{className:"flex gap-2",children:[s(Ze,{className:"w-4 h-4 text-emerald-400 shrink-0"})," Set webhook: api.telegram.org/.../setWebhook?url=your-function-url"]})]})]}),d("div",{className:"rounded-[14px] bg-gradient-to-br from-blue-600 to-indigo-600 p-4 text-white",children:[s("div",{className:"text-[12px] font-bold tracking-widest uppercase opacity-80",children:"Why this flow?"}),s("div",{className:"text-[13px] leading-relaxed mt-2",children:"User কখনো Telegram দেখবে না। Website এ real-time reply আসবে RTDB থেকে। তুমি Telegram থেকে reply দেবে, client Website এ live দেখবে — premium SaaS feel."})]})]})]})]}),e===5&&d("div",{className:"grid md:grid-cols-[1.1fr_0.9fr] gap-6",children:[d("div",{className:"space-y-4",children:[s(Kt,{title:"terminal",lang:"bash",code:`# 1. Build
