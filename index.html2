service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for pricing (locked)
    match /pricing/{docId} {
      allow read: if true;
      allow write: if request.auth.token.email == "afshakil279@gmail.com";
    }
    // Leads: create allowed, read only admin
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null 
        && request.auth.token.email == "afshakil279@gmail.com";
    }
    // Chats: user can read own
    match /chats/{userId} {
      allow read, write: if request.auth != null 
        && (request.auth.uid == userId 
        || request.auth.token.email == "afshakil279@gmail.com");
    }
  }
}`}),s(Kt,{title:"realtime database.rules.json",code:`{
  "rules": {
    "chats": {
